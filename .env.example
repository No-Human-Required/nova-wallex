# Set these in Runflare runtime variables; do not include real secrets in a ZIP.
SW_ENV=production
SW_PUBLIC_READ_ONLY=1
SW_PUBLIC_ORIGIN=https://your-domain.example
SW_ADMIN_PASSWORD=replace-with-a-unique-random-password-at-least-20-characters
SW_DATA_DIR=/data
# PostgreSQL is authoritative; /data is disposable scratch, no app volume needed.
SW_DATABASE_URL=postgresql://user:password@internal-database-host:5432/database
SW_DB_NAMESPACE=starwallex
PORT=8080
# Generate once; retain across deploys. Enter exchange/AI keys only in the panel.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SW_VAULT_KEY=replace-with-a-generated-Fernet-key
